// === ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ===
let currentTaskNumber = null;
let currentVariant = null;
let currentLevel = null;
let timer;
let timeLeft = 14100;
let isRunning = false;

// === НАВИГАЦИЯ ===
const navLinks = document.querySelectorAll('.nav-link');
const pages = document.querySelectorAll('.page');
const timerContainer = document.getElementById('timerContainer');

navLinks.forEach(link => {
  link.addEventListener('click', function(e) {
    e.preventDefault();
    navLinks.forEach(l => l.classList.remove('active'));
    this.classList.add('active');
    const targetPage = this.getAttribute('data-page');
    pages.forEach(page => page.classList.remove('active'));
    document.getElementById(targetPage).classList.add('active');
    if (targetPage === 'practice') {
      timerContainer.style.display = 'block';
      startTimer();
    } else {
      timerContainer.style.display = 'none';
    }
    window.scrollTo(0, 0);
  });
});

// === DROPDOWN ===
const startDropdown = document.getElementById('startDropdown');
const startBtn = document.getElementById('startBtn');
let dropdownTimeout;

startBtn.addEventListener('click', function(e) {
  e.preventDefault();
  startDropdown.classList.add('show');
  dropdownTimeout = setTimeout(() => {
    startDropdown.classList.remove('show');
  }, 8000);
});

document.addEventListener('click', function(e) {
  if (!startDropdown.contains(e.target)) {
    startDropdown.classList.remove('show');
    clearTimeout(dropdownTimeout);
  }
});

// === ВЫБОР УРОВНЯ ===
document.querySelectorAll('.level-basic, .level-medium, .level-advanced').forEach(button => {
  button.addEventListener('click', e => {
    e.preventDefault();
    const level = button.getAttribute('data-level');
    currentLevel = level;
    const variants = egeVariants[level];
    currentVariant = variants[0];
    
    pages.forEach(p => p.classList.remove('active'));
    document.getElementById('practice').classList.add('active');
    document.getElementById('variantInfo').style.display = 'block';
    document.getElementById('variantNumber').textContent = currentVariant.id;
    
    const badge = document.getElementById('levelBadge');
    const levelNames = { basic: 'Базовый', medium: 'Средний', advanced: 'Продвинутый' };
    badge.textContent = levelNames[level];
    badge.className = 'level-badge ' + level;
    
    generateVariantTasks(currentVariant.tasks);
    timerContainer.style.display = 'block';
    resetTimer();
    startTimer();
    startDropdown.classList.remove('show');
    clearTimeout(dropdownTimeout);
    window.scrollTo(0, 0);
  });
});

// === СБРОС ТАЙМЕРА ===
function resetTimer() {
  clearInterval(timer);
  isRunning = false;
  timeLeft = 14100;
  localStorage.setItem('egeTimer', timeLeft);
}

// === ГЕНЕРАЦИЯ ЗАДАНИЙ С SVG ===
function generateVariantTasks(tasks) {
  const part1 = document.getElementById('part1');
  let html = '<div class="practice-questions">';
  
  tasks.forEach(task => {
    let svgHtml = task.svg ? `<div class="task-svg-container">${task.svg}</div>` : '';
    html += `<div class="practice-question">
      <span class="question-number">${task.num}</span>
      <p class="question-text">${task.text}</p>
      ${svgHtml}
      <input type="text" class="answer-input" id="answer${task.num}" placeholder="Ваш ответ">
    </div>`;
  });
  
  html += '</div>';
  part1.innerHTML = html;
}

async function loadThemeContent(taskNumber, themeSlug) {
  const filePath = `tasks/task${taskNumber}/${themeSlug}.html`;
  console.log('📂 Загрузка файла:', filePath); // <-- Добавлено
  
  try {
    const response = await fetch(filePath);
    console.log('📥 Ответ сервера:', response.status); // <-- Добавлено
    
    if (!response.ok) throw new Error('Файл не найден');
    const html = await response.text();
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const bodyContent = doc.body.innerHTML;
    return bodyContent.trim() ? bodyContent : html;
  } catch (error) {
    console.error('❌ Ошибка загрузки:', error); // <-- Улучшено
    console.warn(`⚠️ Не удалось загрузить ${filePath}`);
    return `<div style="color:#666; text-align:center; padding:30px; border:2px dashed #ccc; border-radius:10px;">
      📝 Контент для темы ещё не добавлен.<br><br>
      <strong>Создайте файл:</strong><br>
      <code style="background:#f5f5f5; padding:5px 10px; border-radius:4px;">${filePath}</code>
    </div>`;
  }
}

// === ПОКАЗАТЬ СПИСОК ТЕМ ===
function showTask(taskNumber) {
  currentTaskNumber = taskNumber;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('theory-tasks').classList.add('active');
  document.getElementById('task-title').textContent = `Задание ${taskNumber}`;
  
  const container = document.getElementById('topics-container');
  container.innerHTML = '';
  
  const topics = getTopicsForTask(taskNumber);
  topics.forEach(topic => {
    const btn = document.createElement('button');
    btn.className = 'topic-btn';
    btn.textContent = topic.name;
    btn.onclick = () => showTheme(topic.name, topic.slug, taskNumber);
    container.appendChild(btn);
  });
  
  addBackButtonToTasks();
  window.scrollTo(0, 0);
}

function getTopicsForTask(taskNumber) {
  return topicsMap[taskNumber] || [{ name: 'Тема в разработке', slug: 'coming-soon' }];
}

// === ПОКАЗАТЬ КОНТЕНТ ТЕМЫ ===
async function showTheme(themeName, themeSlug, taskNumber) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('theory-theme').classList.add('active');
  document.getElementById('theme-title').textContent = themeName;
  
  const contentDiv = document.getElementById('theme-content');
  contentDiv.innerHTML = '<div style="text-align:center; padding:40px;">🔄 Загрузка...</div>';
  
  const html = await loadThemeContent(taskNumber, themeSlug);
  contentDiv.innerHTML = html;
  
  if (window.MathJax && typeof MathJax.typesetPromise === 'function') {
    MathJax.typesetPromise();
  }
  
  addBackButtonToTheme(taskNumber);
  window.scrollTo(0, 0);
}

// === КНОПКИ "НАЗАД" ===
function addBackButtonToTheme(taskNumber) {
  const id = 'back-to-tasks';
  let btn = document.getElementById(id);
  if (!btn) {
    btn = document.createElement('button');
    btn.id = id;
    btn.className = 'back-button';
    btn.textContent = '← Вернуться к темам задания';
    document.getElementById('theory-theme').insertBefore(btn, document.getElementById('theme-title'));
  }
  btn.onclick = () => {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('theory-tasks').classList.add('active');
    if (currentTaskNumber) {
      document.getElementById('task-title').textContent = `Задание ${currentTaskNumber}`;
      const container = document.getElementById('topics-container');
      container.innerHTML = '';
      getTopicsForTask(currentTaskNumber).forEach(topic => {
        const btn = document.createElement('button');
        btn.className = 'topic-btn';
        btn.textContent = topic.name;
        btn.onclick = () => showTheme(topic.name, topic.slug, currentTaskNumber);
        container.appendChild(btn);
      });
    }
  };
}

function addBackButtonToTasks() {
  const id = 'back-to-theory';
  let btn = document.getElementById(id);
  if (!btn) {
    btn = document.createElement('button');
    btn.id = id;
    btn.className = 'back-button';
    btn.textContent = '← Вернуться к списку заданий';
    const container = document.getElementById('topics-container');
    container.parentNode.insertBefore(btn, container);
  }
  btn.onclick = backToTheory;
}

function backToTheory() {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('theory').classList.add('active');
  currentTaskNumber = null;
}

function backToTasks() {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('theory-tasks').classList.add('active');
  if (currentTaskNumber) {
    document.getElementById('task-title').textContent = `Задание ${currentTaskNumber}`;
  }
}

// === ТАЙМЕР ===
function updateTimer() {
  const h = Math.floor(timeLeft / 3600);
  const m = Math.floor((timeLeft % 3600) / 60);
  const s = timeLeft % 60;
  document.getElementById('timerDisplay').textContent =
    `${h.toString().padStart(2,'0')}:${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
}

function startTimer() {
  if (isRunning) return;
  isRunning = true;
  if (localStorage.getItem('egeTimer')) {
    timeLeft = parseInt(localStorage.getItem('egeTimer'));
  }
  updateTimer();
  timer = setInterval(() => {
    if (timeLeft > 0) {
      timeLeft--;
      localStorage.setItem('egeTimer', timeLeft);
      updateTimer();
    } else {
      clearInterval(timer);
      isRunning = false;
      alert('⏰ Время вышло! Тест будет завершён автоматически.');
      checkAnswers();
    }
  }, 1000);
}

// === ПРОВЕРКА ОТВЕТОВ (ИСПРАВЛЕННАЯ СИСТЕМА БАЛЛОВ) ===
function checkAnswers() {
  clearInterval(timer);
  isRunning = false;
  timerContainer.style.display = 'none';
  
  const resultsTableBody = document.getElementById('resultsTableBody');
  resultsTableBody.innerHTML = '';
  
  let totalPrimaryScore = 0;
  
  if (!currentVariant) return;
  
  currentVariant.tasks.forEach(task => {
    const input = document.getElementById(`answer${task.num}`);
    const userAns = input ? input.value.trim().toLowerCase() : '';
    const correctAns = task.answer.toLowerCase();
    
    let isCorrect = false;
    if (userAns === correctAns) isCorrect = true;
    else if (userAns.replace(/\s/g, '') === correctAns.replace(/\s/g, '')) isCorrect = true;
    
    // Получаем баллы за задание из data
    const taskPoints = task.points || 1;
    if (isCorrect) {
      totalPrimaryScore += taskPoints;
    }
    
    const row = document.createElement('tr');
    row.innerHTML = `
      <td>${task.num}</td>
      <td>${userAns || '—'}</td>
      <td>${task.answer}</td>
      <td style="font-weight:700; color:${isCorrect ? 'var(--success)' : 'var(--warning)'}">
        ${isCorrect ? taskPoints : 0}/${taskPoints}
      </td>
    `;
    resultsTableBody.appendChild(row);
  });
  
  // ТАБЛИЦА ПЕРЕВОДА ПЕРВИЧНЫХ БАЛЛОВ В ТЕСТОВЫЕ (ЕГЭ 2026)
  const conversionTable = {
    0: 0, 1: 6, 2: 11, 3: 17, 4: 22, 5: 27, 6: 33, 7: 39, 8: 44, 9: 50,
    10: 56, 11: 62, 12: 68, 13: 70, 14: 72, 15: 74, 16: 76, 17: 78,
    18: 80, 19: 82, 20: 84, 21: 86, 22: 88, 23: 90, 24: 92, 25: 94,
    26: 95, 27: 96, 28: 97, 29: 98, 30: 99, 31: 100, 32: 100
  };
  
  const hundredScore = conversionTable[totalPrimaryScore] || 0;
  
  document.getElementById('finalScore').textContent = totalPrimaryScore;
  document.getElementById('finalResultText').textContent = `Вы набрали ${totalPrimaryScore} первичных баллов из 32`;
  document.getElementById('convertedScore').textContent = `Перевод в 100-балльную систему: ${hundredScore} баллов`;
  
  document.getElementById('resultSection').style.display = 'block';
  document.getElementById('resultSection').scrollIntoView({ behavior: 'smooth' });
}

function resetPractice() {
  document.querySelectorAll('.answer-input').forEach(inp => inp.value = '');
  document.getElementById('resultSection').style.display = 'none';
  document.getElementById('variantInfo').style.display = 'none';
  clearInterval(timer);
  timeLeft = 14100;
  localStorage.setItem('egeTimer', timeLeft);
  isRunning = false;
  currentVariant = null;
  currentLevel = null;
  window.scrollTo(0, 0);
}

document.getElementById('submitAnswers').addEventListener('click', checkAnswers);

// === ПРОГРЕСС ===
const checkboxes = document.querySelectorAll('.topic-checkbox');
checkboxes.forEach(cb => {
  if (localStorage.getItem(`topic_${cb.getAttribute('data-topic')}`) === 'true') {
    cb.checked = true;
  }
  cb.addEventListener('change', () => {
    localStorage.setItem(`topic_${cb.getAttribute('data-topic')}`, cb.checked);
    updateProgress();
  });
});

function updateProgress() {
  const total = checkboxes.length;
  const completed = document.querySelectorAll('.topic-checkbox:checked').length;
  const percentage = Math.round((completed / total) * 100);
  document.querySelector('.progress-percentage').textContent = `${percentage}%`;
  document.getElementById('progressFill').style.width = `${percentage}%`;
}

updateProgress();

// === ГЕНЕРАЦИЯ СПИСКОВ ЗАДАНИЙ В ТЕОРИИ ===
function generateTheoryTaskLists() {
  const part1List = document.getElementById('taskListPart1');
  const part2List = document.getElementById('taskListPart2');
  
  for (let i = 1; i <= 12; i++) {
    const btn = document.createElement('button');
    btn.className = 'task-btn';
    btn.textContent = `Задание ${i}`;
    btn.onclick = () => showTask(i.toString());
    part1List.appendChild(btn);
  }
  
  for (let i = 13; i <= 19; i++) {
    const btn = document.createElement('button');
    btn.className = 'task-btn';
    btn.textContent = `Задание ${i}`;
    btn.onclick = () => showTask(i.toString());
    part2List.appendChild(btn);
  }
}

// === ИНИЦИАЛИЗАЦИЯ ===
document.addEventListener('DOMContentLoaded', () => {
  generateTheoryTaskLists();
  if (localStorage.getItem('egeTimer')) {
    timeLeft = parseInt(localStorage.getItem('egeTimer'));
    updateTimer();
  }
  console.log('✅ KeySMath загружен. Готов к работе!');
});
</script>
</body>
</html>